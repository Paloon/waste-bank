{
  "name": "waste-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "migrate:supabase": "node --env-file=.env.cloud.local scripts/migrate-supabase.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/kiosk-browser.mjs && node tests/read-ui-browser.mjs",
    "test:all": "npm test && npm run build && npm run test:browser",
    "staff": "node --env-file-if-exists=.env scripts/staff.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "check:operations": "node --env-file-if-exists=.env scripts/check.mjs",
    "check:status": "node --env-file-if-exists=.env scripts/check-status.mjs",
    "verify:recovery": "node --env-file-if-exists=.env scripts/verify-recovery.mjs",
    "format": "prettier --write server src shared scripts tests",
    "test:load": "node scripts/load-test.mjs",
    "test:performance": "node scripts/benchmark-performance.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "vite": "^6.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
