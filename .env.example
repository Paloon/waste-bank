PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
RETENTION_DAYS=30
PENDING_RETENTION_DAYS=90
APPROVED_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
# Optional school academic year; otherwise current Gregorian year in Bangkok.
SCHOOL_YEAR=
# NODE_ENV=production enforces HTTPS + secrets and disables demo auto-seeding.
NODE_ENV=development
DEMO_MODE=0
TRUST_PROXY=0
SECURE_COOKIE=0
# Google Drive: ใส่ OAuth Client ID/Secret จาก Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_WASTE_FOLDER_ID=
DRIVE_REWARDS_FOLDER_ID=
DRIVE_EVIDENCE_FOLDER_ID=
# สำหรับ Vercel + Supabase เท่านั้น (เก็บใน Vercel Environment Variables)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SESSION_SECRET=
PUBLIC_BASE_URL=
# Preferred on Vercel; save as Config (not Secret). Overrides PUBLIC_BASE_URL.
WASTE_BANK_BASE_URL=
CRON_SECRET=
# Local backup only. Keep BACKUP_KEY outside Vercel and retain a recovery copy.
BACKUP_DIR=.backups
BACKUP_KEY=
BACKUP_KEEP_DAYS=7
# Only set temporarily for npm run staff create/reset; never commit or pass on command line.
STAFF_PIN=
